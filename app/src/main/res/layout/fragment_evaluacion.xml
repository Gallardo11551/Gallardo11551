<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ti_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="40dp">

        <!-- Título mejorado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/evaluacion_titulo"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="28sp"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="8"/>

            <ImageButton
                android:id="@+id/btnInfo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_dialog_info"
                android:contentDescription="@string/info"
                android:tint="#FFFFFF"
                android:alpha="0.7"/>
        </LinearLayout>

        <!-- Descripción -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/evaluacion_desc"
            android:textColor="#E0E0E0"
            android:textSize="14sp"
            android:layout_marginBottom="20dp"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="6"/>

        <!-- Imagen de estado -->
        <ImageView
            android:id="@+id/imgEstado"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"/>

        <!-- Producto -->
        <TextView
            android:id="@+id/txtProducto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Producto: 0%"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="4dp"
            android:padding="10dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#6B3FF2FF"
            app:cornerRadius="8dp"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="6"/>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderProducto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="100"
            android:stepSize="1"
            app:trackColorActive="#E91E63"
            app:trackColorInactive="#60404060"
            app:thumbColor="#E91E63"
            android:layout_marginBottom="12dp"/>

        <!-- Desempeño -->
        <TextView
            android:id="@+id/txtDesempeno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Desempeño: 0%"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="4dp"
            android:padding="10dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#6B3FF2FF"
            app:cornerRadius="8dp"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="6"/>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderDesempeno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="100"
            android:stepSize="1"
            app:trackColorActive="#00BCD4"
            app:trackColorInactive="#60404060"
            app:thumbColor="#00BCD4"
            android:layout_marginBottom="12dp"/>

        <!-- Conocimiento -->
        <TextView
            android:id="@+id/txtConocimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Conocimiento: 0%"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="4dp"
            android:padding="10dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#6B3FF2FF"
            app:cornerRadius="8dp"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="6"/>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderConocimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="100"
            android:stepSize="1"
            app:trackColorActive="#4CAF50"
            app:trackColorInactive="#60404060"
            app:thumbColor="#4CAF50"
            android:layout_marginBottom="12dp"/>

        <!-- Asistencia -->
        <TextView
            android:id="@+id/txtAsistencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Asistencia: 0%"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="4dp"
            android:padding="10dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#6B3FF2FF"
            app:cornerRadius="8dp"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="6"/>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderAsistencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="100"
            android:stepSize="1"
            app:trackColorActive="#FFC107"
            app:trackColorInactive="#60404060"
            app:thumbColor="#FFC107"
            android:layout_marginBottom="16dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCalcular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/calcular_resultado"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:paddingVertical="14dp"
            app:cornerRadius="30dp"
            app:backgroundTint="#2196F3"
            app:elevation="8dp"/>

        <!-- Card Resultado mejorada -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#CC1A237E"
            app:strokeColor="#FFC107"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RESULTADO"
                    android:textColor="#FFC107"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:letterSpacing="0.2"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/txtResultado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="..."
                    android:textStyle="bold"
                    android:textSize="26sp"
                    android:textColor="#FFFFFF"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>